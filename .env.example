# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_strong_password

# ── API Keys (gratuites) ──────────────────────────────────────────────────────
FOOTBALL_DATA_API_KEY=your_football_data_org_key_here
BALLDONTLIE_API_KEY=your_balldontlie_key_here  # OBLIGATOIRE — clé vide = 401 (inscription gratuite sur app.balldontlie.io)

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# ── Scheduler ────────────────────────────────────────────────────────────────
INGESTION_HOUR_UTC=6
RETRAIN_WEEKDAY=mon
RETRAIN_HOUR_UTC=3
PREDICT_HORIZON_HOURS=36  # Horizon de prédiction (heures) — défaut 36 h

# ── Sécurité ──────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
INTERNAL_API_TOKEN=your_secret_token_here

# ── Cloudflare Access (optionnel — dev local sans ces variables si AUTH_DISABLED=true) ──
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=your_audience_tag_here
AUTH_DISABLED=false  # true = désactive la vérif CF Access en dev local uniquement

# ── The Odds API ─────────────────────────────────────────────────────────────
# Cotes en temps réel (Ligue 1 + NBA). Tier gratuit : 500 req/mois.
# Inscription : https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key_here

# ── Claude API ───────────────────────────────────────────────────────────────
# Obligatoire pour les explications par prédiction et l'agent post-match
# Générer sur https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
