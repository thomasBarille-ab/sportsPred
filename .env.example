# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_strong_password

# ── API Keys (gratuites) ──────────────────────────────────────────────────────
FOOTBALL_DATA_API_KEY=your_football_data_org_key_here
BALLDONTLIE_API_KEY=your_balldontlie_key_here  # OBLIGATOIRE — clé vide = 401 (inscription gratuite sur app.balldontlie.io)

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# ── Scheduler ────────────────────────────────────────────────────────────────
INGESTION_HOUR_UTC=6
RETRAIN_WEEKDAY=mon
RETRAIN_HOUR_UTC=3
PREDICT_HORIZON_HOURS=36  # Horizon de prédiction (heures) — défaut 36 h

# ── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
